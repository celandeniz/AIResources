{
  "name": "dynamicsops-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "DynamicsOps AI Resource Platform — internal AI digital-employee platform",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @dynops/db generate",
    "db:push": "pnpm --filter @dynops/db push",
    "db:seed": "pnpm --filter @dynops/db build && pnpm --filter @dynops/db seed",
    "up": "docker compose up --build",
    "down": "docker compose down -v"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# DynamicsOps AI Resource Platform — environment template
# Copy to `.env`. The vertical slice runs with ZERO real credentials (mock
# adapters + dev-login + stub LLM provider). Real values only needed for M6.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core infra (docker-compose service names) ---
POSTGRES_USER=dynops
POSTGRES_PASSWORD=dynops
POSTGRES_DB=dynops
DATABASE_URL=postgresql://dynops:dynops@postgres:5432/dynops?schema=public

REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# --- Service URLs (internal docker network) ---
API_URL=http://api:4000
AGENT_URL=http://agent:8000
WEB_PUBLIC_API_URL=http://localhost:4000

# --- Ports (host) ---
API_PORT=4000
AGENT_PORT=8000
WEB_PORT=3000

# --- Auth ---
# dev = local dev-login stub (no Entra). entra = real Microsoft Entra ID OIDC.
AUTH_MODE=dev
JWT_SECRET=dev-only-change-me
# Entra (only when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Internal service-to-service token (worker/api -> agent) ---
INTERNAL_TOKEN=dev-internal-token

# --- LLM providers ---
# PRIMARY = NVIDIA NIM (build.nvidia.com free APIs). Get a free key at
# https://build.nvidia.com and set it here — all seeded resources default to
# NIM models (llama-3.3-70b / qwen2.5-coder-32b / llama-3.1-8b).
# IMPORTANT: with the NIM defaults applied and NO key set, those resources hit
# the deterministic STUB (not Ollama). Either set the key, or switch resources
# back to Ollama in the Directory for keyless local inference.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Free-tier keys are rate-limited (~40 RPM) — cap concurrent NIM calls.
NVIDIA_MAX_CONCURRENCY=2

# FALLBACK = free local models via Ollama. When a cloud provider errors (NIM
# 429, Gemini 503, timeouts) the agent retries on OLLAMA_FALLBACK_MODEL before
# the deterministic stub. Run `ollama serve` on the host and pull models:
#   ollama pull qwen3 && ollama pull llama4 && ollama pull deepseek-r1 \
#     && ollama pull gemma3 && ollama pull mistral-small
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_FALLBACK_MODEL=qwen3

# Premium providers — optional per-resource overrides via the Directory.
# Leave empty to fall back to stub for those too.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Google Gemini (Generative Language API)
GEMINI_API_KEY=

# --- Embeddings (optional; empty => deterministic stub embedder) ---
EMBEDDING_PROVIDER=stub

# ─────────────────────────────────────────────────────────────────────────────
# Connection Registry (M6 real connectors — all optional, mocked until set)
# ─────────────────────────────────────────────────────────────────────────────
# Business Central (Dynamics 365 BC SaaS)
BC_TENANT_ID=7fa2357e-26f2-4174-8e16-a713981356b8
BC_ENVIRONMENT=Production
BC_COMPANY_1=Dynamics Ops Bilgi Tek Ltd Sti
BC_COMPANY_2=Dynamics Ops
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# Azure DevOps (comma-separated org names; PAT per org via Key Vault in prod)
ADO_ORGS=
ADO_PAT=
# Bidirectional ADO sync: rev-aware update re-ingestion (echo-suppressed — needs
# a resolvable self identity; set ADO_SELF_IDENTITY="Display Name <email>" if
# /connectionData doesn't resolve), service-hook receiver secret, and the
# whitelist of states the platform may set automatically (never Closed/Done).
ENABLE_ADO_UPDATE_REINGEST=false
ADO_WEBHOOK_SECRET=
ADO_SELF_IDENTITY=
ADO_AUTO_STATES=Active,In Progress,Resolved,Ready for Review

# ─────────────────────────────────────────────────────────────────────────────
# Coverage Watchdog — org-wide stalled-topic radar (mail + Teams kanalları).
# Rollout: 1) ENABLE + dry-run 1-2 hafta → 2) COVERAGE_DRY_RUN=false →
# 3) ENABLE_COVERAGE_AUTOSEND=true (kademeli otonomi; sıkı limitlerle).
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_COVERAGE_WATCHDOG=false
COVERAGE_DRY_RUN=true
COVERAGE_SLA_UNANSWERED_H=24
COVERAGE_SLA_COMMITMENT_H=48
COVERAGE_SLA_DROPPED_D=7
COVERAGE_BACKFILL_DAYS=14
# Autosend: onaylanmayan takip taslakları SLA sonunda otomatik gönderilir.
# Gönderim öncesi insan-yanıtı kontrolü + sessiz saatler + günlük müşteri limiti.
ENABLE_COVERAGE_AUTOSEND=false
COVERAGE_AUTOSEND_TIMEOUT_H=4
COVERAGE_QUIET_HOURS=18-08
COVERAGE_MAX_AUTOSENDS_PER_CUSTOMER_DAY=2
# Teams 1:1/grup sohbetleri: Microsoft PROTECTED API — tenant onayı + metered
# lisans gerektirir. Onay gelene kadar kapalı tutun.
ENABLE_COVERAGE_CHATS=false
COVERAGE_AUTODISCOVER_MAILBOXES=false

# ─────────────────────────────────────────────────────────────────────────────
# Autonomous dev pods (BC/F&SCM) — ADO work item → analiz → kod (OpenCode) →
# test → AL-Go CI → doküman → draft PR. Merge her zaman insanda.
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_DEV_PODS=false
DEV_POD_TEMPLATES=bc_dev,fscm_dev
# Plan Canvas: bu template'lerin görev grafiği çalışmadan önce insan onayı ister.
PLAN_GATE_TEMPLATES=bc_dev,fscm_dev
DEV_POD_REPO=dynamicsops/DynOpsBC
DEV_POD_REPO_KEY=dynopsbc
DEV_POD_CI_WORKFLOW=CICD.yaml
DEV_POD_BASE_BRANCH=main
DEV_POD_MAX_PR_FILES=40
# Multi-repo OpenCode: repoKey=serverUrl listesi (her repo kendi `opencode serve`)
OPENCODE_SERVERS=
OPENCODE_TIMEOUT_MS=1800000

# Project Hub — proje başına canlı dashboard + Cosmos proje senkronu
ENABLE_PROJECT_HUB=true

# GitHub (comma-separated owner/repo; GitHub App or PAT)
GITHUB_REPOS=
GITHUB_TOKEN=

# OpsConnect (portal + hub)
OPSCONNECT_BASE_URL=https://opsconnect.dynamicsops.com
OPSCONNECT_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Graph — REAL Outlook + Teams (app-only / client credentials)
# Entra app registration with admin-consented APPLICATION permissions:
#   Mail.Read, Mail.Send, ChannelMessage.Read.All
# Leave empty to keep Outlook/Teams connectors mock + the ingestion poller idle.
# ─────────────────────────────────────────────────────────────────────────────
GRAPH_TENANT_ID=7fa2357e-26f2-4174-8e16-a713981356b8
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
POLL_INTERVAL_MS=60000

# Obsidian vault knowledge base (read-only). Point at your vault folder; leave unset to skip.
OBSIDIAN_VAULT_HOST_PATH=
ENABLE_OBSIDIAN_SYNC=false

# Microsoft Teams bot — leave blank to keep the bot DISABLED (fail-closed).
# Set a random secret to enable the dev gate; production also needs TEAMS_BOT_APP_ID/PASSWORD.
TEAMS_BOT_SECRET=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
